# Copie este arquivo para ".env" e preencha os valores.

# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=coloque_seu_token_aqui

# Pasta onde os chamados serão salvos.
# Local:        ./chamados
# Servidor:     /mnt/servidor/chamados
# Google Drive: /home/usuario/GoogleDrive/Chamados  (via Google Drive Desktop/rclone)
STORAGE_ROOT=./chamados

# (opcional) canal onde o painel será postado automaticamente ao iniciar
PANEL_CHANNEL_ID=0

# IDs de cargos administrativos, separados por vírgula (ex: 123, 456)
ADMIN_ROLE_IDS=

# tempo máximo de espera por resposta, em segundos (padrão 1800 = 30 min)
STEP_TIMEOUT=1800
